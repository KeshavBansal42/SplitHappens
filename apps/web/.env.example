# ---- SplitStream web (Privy client) environment -------------------
# Copy to apps/web/.env and fill in real values. Never commit .env.

# Privy App ID, create a testnet app at https://dashboard.privy.io/.
# Use the shared team app id so everyone tests against the same config.
VITE_PRIVY_APP_ID=

# Arc testnet (chain id 5042002). Gas on Arc is paid in USDC.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network

# USDC token address on Arc testnet, from the Arc docs contract-addresses
# page (contract lead). Leave blank to run against the public Arc RPC with
# balance display disabled.
VITE_USDC_ADDRESS=

# Escrow contract address on Arc testnet, published by the contract lead.
# Leave blank to disable the pay button.
VITE_ESCROW_ADDRESS=

# Local dev only: set both to talk to a dev-mode API (AUTH_MODE=dev) with
# header-based auth instead of Privy JWTs. Never set in production.
VITE_DEV_USER_ID=
VITE_DEV_WALLET=
