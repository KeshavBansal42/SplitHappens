# ---- splitHappens web (Privy client) environment -------------------
# Copy to apps/web/.env and fill in real values. Never commit .env.

# Privy App ID, create a testnet app at https://dashboard.privy.io/.
VITE_PRIVY_APP_ID=

# Arc testnet (chain id 5042002). Gas on Arc is paid in USDC.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.network

# USDC token address on Arc testnet.
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Escrow contract address on Arc testnet.
VITE_ESCROW_ADDRESS=0xf77bbF1907150F2a633A0748A14Fb3Bb29f7f961

# Local dev only: set these to talk to a dev-mode API (AUTH_MODE=dev) with
# header-based auth instead of Privy JWTs. Never set in production.
VITE_DEV_USER_ID=
VITE_DEV_WALLET=
VITE_DEV_EMAIL=
