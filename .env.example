# ---- SplitStream API environment -----------------------------------
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres. Matches docker-compose.yml when using the container, or point
# at any local/external postgres 16.
DATABASE_URL=postgresql://splitstream:splitstream@localhost:5432/splitstream

# Auth. AUTH_MODE=privy (default) verifies Privy JWTs on every request.
# AUTH_MODE=dev trusts x-dev-user-id / x-dev-wallet headers instead —
# for local development and API testing before Privy credentials exist.
# Never run AUTH_MODE=dev outside local development.
AUTH_MODE=privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Arc testnet (chain id 5042002). Gas on Arc is paid in USDC.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Escrow + USDC addresses on Arc testnet. USDC_ADDRESS comes from the Arc
# docs contract-addresses page; ESCROW_ADDRESS from the contract deploy.
USDC_ADDRESS=
ESCROW_ADDRESS=

# Backend wallet that calls release(). Must hold testnet USDC for gas
# (Circle faucet: https://faucet.circle.com/ or https://arc-faucet.dev/).
RELEASER_PRIVATE_KEY=

# Watcher cadence (ms)
WATCH_INTERVAL_MS=10000
CONFIRM_INTERVAL_MS=5000
