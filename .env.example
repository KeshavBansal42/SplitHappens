# a private key funded with a little testnet USDC (for gas) from faucet.circle.com
DEPLOYER_PRIVATE_KEY=

# Arc testnet USDC system contract (6 decimals).
# On Arc testnet this is 0x3600000000000000000000000000000000000000
# See: https://docs.arc.net/contracts
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# usually fine to leave this as-is, only change if the main RPC is down
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network