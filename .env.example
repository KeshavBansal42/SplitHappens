# Copy to .env and fill in the blanks. `docker compose` reads this file.
# Never commit the real .env (it holds your releaser private key).

NODE_ENV=development
PORT=4000

# Used when running the API locally. In Docker the API connects to the
# bundled postgres service by itself, so this value is only for bare-metal.
DATABASE_URL=postgresql://splithappens:splithappens@localhost:5432/splithappens

# Auth. "privy" is the real path (email login + embedded wallets).
# Set "dev" plus VITE_DEV_USER_ID / VITE_DEV_WALLET below for a quick local
# smoke test without Privy.
AUTH_MODE=privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=

ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

USDC_ADDRESS=0x3600000000000000000000000000000000000000
ESCROW_ADDRESS=0xf77bbF1907150F2a633A0748A14Fb3Bb29f7f961

# Wallet the backend uses to call openSplit on the shared escrow. It never
# pays a share, but it DOES need a little testnet USDC for gas. Keep this a
# throwaway key that holds nothing but testnet funds.
RELEASER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

WATCH_INTERVAL_MS=10000
CONFIRM_INTERVAL_MS=5000

# docker compose host ports (change if something already used them).
POSTGRES_PORT=15432
WEB_PORT=5173

# Only for AUTH_MODE=dev. The browser sends these as x-dev-* headers.
VITE_DEV_USER_ID=
VITE_DEV_WALLET=
