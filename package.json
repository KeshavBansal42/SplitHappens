{
  "name": "splitstream",
  "version": "0.1.0",
  "private": true,
  "description": "SplitStream — group payments with Privy embedded wallets, USDC on Arc, and conditional escrow settlement",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @splitstream/api db:migrate",
    "dev:api": "pnpm --filter @splitstream/api dev"
  }
}
